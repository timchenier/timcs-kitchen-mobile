{
  "name": "timcs-kitchen-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/generate-icon.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:pixel": "eas build -p android --profile preview",
    "build:testflight": "eas build -p ios --profile testflight",
    "submit:testflight": "eas submit -p ios --latest --profile testflight"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-status-bar": "*",
    "expo-keep-awake": "*",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.119.0",
    "expo-constants": "~58.0.16",
    "expo-secure-store": "~58.0.3",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.0",
    "sharp": "^0.34.4"
  }
}
